{
  "Mongo": {
    "ConnectionString": "mongodb://admin:admin@localhost:27017/?authSource=admin",
    "DatabaseName": "techsyslog"
  },
  "Jwt": {
    "SigningKey": "dev-only-256-bit-key-CHANGE-IN-PRODUCTION-please-do-not-commit-this",
    "Issuer": "techsyslog",
    "Audience": "techsyslog-clients",
    "ExpirationHours": 8
  },
  "ViaCep": {
    "BaseUrl": "https://viacep.com.br/ws/"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:4200"]
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "MongoDB": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/techsyslog-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {CorrelationId} {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },
  "AllowedHosts": "*"
}
